@{
    var containerClass = ViewBag.HeaderContainerClass as string ?? "internal-header";
    var eyebrow = ViewBag.HeaderEyebrow as string;
    var title = ViewBag.HeaderTitle as string ?? ViewBag.Title as string;
    var subtitle = ViewBag.HeaderSubtitle as string;
    var buttonText = ViewBag.HeaderButtonText as string;
    var buttonAction = ViewBag.HeaderButtonAction as string;
    var buttonController = ViewBag.HeaderButtonController as string;
    var buttonClass = ViewBag.HeaderButtonClass as string ?? "btn btn-cavex";
    var badgeText = ViewBag.HeaderBadgeText as string;
    var badgeClass = ViewBag.HeaderBadgeClass as string ?? "badge-cavex";
}
<div class="@containerClass">
    <div>
        @if (!string.IsNullOrWhiteSpace(eyebrow))
        {
            <span class="eyebrow">@eyebrow</span>
        }
        <h1 class="cavex-title">@title</h1>
        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="cavex-subtitle">@subtitle</p>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(buttonText) && !string.IsNullOrWhiteSpace(buttonAction))
    {
        <a class="@buttonClass" asp-controller="@buttonController" asp-action="@buttonAction">@buttonText</a>
    }
    else if (!string.IsNullOrWhiteSpace(badgeText))
    {
        <span class="@badgeClass">@badgeText</span>
    }
</div>
